<?xml version="1.0" encoding="utf-8"?>
<!-- Tundu cloud client (src/main/java/al/moveit/cloud): Game Pass, gift cards, signed app and firmware updates. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Re-arm the background check after a reboot (persisted job, nightly alarm). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Self-updates. Silent when device owner or a privileged system app; on Android 12+ also for a plain app that
         updates itself (with UPDATE_PACKAGES_WITHOUT_USER_ACTION). Otherwise Android asks once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <service
            android:name="al.moveit.cloud.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name="al.moveit.cloud.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="al.moveit.cloud.InstallReceiver"
            android:exported="false" />

        <!-- Only active if provisioning makes the app device owner (see AdminReceiver.java). -->
        <receiver
            android:name="al.moveit.cloud.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/tundu_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
