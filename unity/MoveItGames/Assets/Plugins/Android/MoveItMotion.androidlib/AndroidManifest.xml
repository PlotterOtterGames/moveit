<?xml version="1.0" encoding="utf-8"?>
<!-- MoveIt motion service: camera + pose AI inside the APK (see src/main/java/al/moveit/motion). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Boxes use an external USB camera; phones and emulators any camera. None is strictly required to install. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />
</manifest>
