<!--
  Engine classes the build must keep although no script names them. "Strip Engine Code" removes every engine class
  the code and scenes don't reference, but GameObject.CreatePrimitive adds a collider from native code: on the box the
  games logged "Can't add component because class 'SphereCollider' doesn't exist!" for every shape, and Bowling broke
  (its ball and pins need these colliders: NullReferenceException in BuildBall, then every frame in UpdateCamera).
-->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.BoxCollider" preserve="all" />
    <type fullname="UnityEngine.SphereCollider" preserve="all" />
    <type fullname="UnityEngine.CapsuleCollider" preserve="all" />
    <type fullname="UnityEngine.MeshCollider" preserve="all" />
  </assembly>
</linker>
